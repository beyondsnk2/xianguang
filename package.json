{
  "name": "sanwalk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "闲逛 · 三国题材地图挂机游戏 V1（纯前端）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "_bundle": "esbuild tools/check.ts --bundle --platform=node --format=cjs --outfile=node_modules/.sanwalk/check.cjs --log-level=warning",
    "check": "npm run _bundle && node node_modules/.sanwalk/check.cjs",
    "check:v1": "npm run _bundle && node node_modules/.sanwalk/check.cjs firstShow@1",
    "check:v2": "npm run _bundle && node node_modules/.sanwalk/check.cjs firstShow@2",
    "_bundle:calib": "esbuild tools/calib.ts --bundle --platform=node --format=cjs --outfile=node_modules/.sanwalk/calib.cjs --log-level=warning",
    "calib": "npm run _bundle:calib && node node_modules/.sanwalk/calib.cjs",
    "_bundle:sim": "esbuild tools/simulate100.ts --bundle --platform=node --format=cjs --outfile=node_modules/.sanwalk/sim.cjs --log-level=warning",
    "sim": "npm run _bundle:sim && node node_modules/.sanwalk/sim.cjs"
  },
  "dependencies": {
    "sanwalk": "file:",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
